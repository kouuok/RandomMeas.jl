#!/bin/bash
#PBS -N crmnuscan
#PBS -l nodes=1:ppn=8
#PBS -l walltime=72:00:00
#PBS -j oe
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export L=16
export U=4.0
export NU_LIST="50,100,200,400,800,1600,3200,6400"
export N_REPEAT=300
export NM=100
export DMRG_BLAS=8
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
echo "host=$(hostname) start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_nu_scan.jl 2>&1 | tee crm_nu_scan_progress.log
echo "end=$(date)"
