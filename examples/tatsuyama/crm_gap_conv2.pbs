#!/bin/bash
#PBS -N crm_conv2
#PBS -l nodes=1:ppn=8
#PBS -l walltime=6:00:00
#PBS -j oe
#PBS -o crm_conv2.log
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
export DMRG_BLAS=8
julia --project=Hubbard_MPS_Env_v2 crm_gap_conv2.jl 2>&1 | tee crm_conv2_progress.log
