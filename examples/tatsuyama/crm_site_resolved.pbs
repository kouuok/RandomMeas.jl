#!/bin/bash
#PBS -N crm_site
#PBS -l nodes=1:ppn=8
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o crm_site.log

# 使い方: qsub crm_site_resolved.pbs
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1

export L_LIST="${L_LIST:-8,16,32,64,128}"
export DOPE_LIST="${DOPE_LIST:-0.0,0.125}"
export N_REPEAT="${N_REPEAT:-1000}"
export NBOOT="${NBOOT:-600}"
export CHI_EXP="${CHI_EXP:-256}"
export DMRG_BLAS="${DMRG_BLAS:-8}"
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"

echo "host=$(hostname) L_LIST=${L_LIST} DOPE=${DOPE_LIST} N_REPEAT=${N_REPEAT} CHI_EXP=${CHI_EXP} start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_site_resolved.jl 2>&1 | tee crm_site_progress.log
echo "end=$(date)"
