#!/bin/bash
#PBS -N crmnuseed
#PBS -l nodes=1:ppn=8
#PBS -l walltime=72:00:00
#PBS -j oe
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export L=16 U=4.0 NM=100 N_REPEAT=300
export NU_LIST="50,400,3200"
export SEED_LIST="0,1,2,3,4,5,6,7"
export DMRG_BLAS=8
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
echo "host=$(hostname) start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_nu_seed.jl 2>&1 | tee crm_nu_seed_progress.log
echo "end=$(date)"
