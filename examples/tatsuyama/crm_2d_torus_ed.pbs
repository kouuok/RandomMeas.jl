#!/bin/bash
#PBS -N crm2dted
#PBS -l nodes=1:ppn=4
#PBS -l walltime=72:00:00
#PBS -j oe
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export LX=3 W=4
export CHI_EXP="${CHI_EXP:-2048}"
export NU=240
export N_REPEAT=300
export DMRG_BLAS=4
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
echo "host=$(hostname) UVAL=${UVAL} start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_2d_torus_ed.jl 2>&1 | tee "crm_2d_torus_ed_U${UVAL}_progress.log"
echo "end=$(date)"
