#!/bin/bash
#PBS -N crmeigcorr
#PBS -l nodes=1:ppn=16
#PBS -l walltime=72:00:00
#PBS -j oe
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export W="${W:-1}" LX="${LX:-32}" PBC="${PBC:-0}" CRM_U="${CRM_U:-8.0}"
export CHIMAX="${CHIMAX:-2048}" CUTOFF="${CUTOFF:-1e-14}" SWEEPS_PER="${SWEEPS_PER:-10}"
export DMRG_BLAS=16 JULIA_NUM_THREADS=1 JULIA_LOAD_PATH="@:@v#.#:@stdlib"
GEO=$([ "$PBC" = "1" ] && echo torus || echo cylinder)
echo "host=$(hostname) W=${W} LX=${LX} ${GEO} U=${CRM_U} chi=${CHIMAX} cutoff=${CUTOFF} start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_eigen_corr.jl 2>&1 | tee "crm_eigcorr_W${W}L${LX}_${GEO}_U${CRM_U}.log"
echo "end=$(date)"
