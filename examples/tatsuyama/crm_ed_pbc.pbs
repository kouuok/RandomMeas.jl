#!/bin/bash
#PBS -N crm_edpbc
#PBS -l nodes=1:ppn=8
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -o crm_edpbc.log
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export L_LIST="8,12,14"
export BC_LIST="obc,pbc"
export N_REPEAT="500"
export SEED_LIST="0,1,2"
export CHI_EXP="1024"
export FID_LMAX="12"
export DMRG_BLAS=8
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
echo "host=$(hostname) start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_ed_pbc.jl 2>&1 | tee crm_edpbc_progress.log
echo "end=$(date)"
