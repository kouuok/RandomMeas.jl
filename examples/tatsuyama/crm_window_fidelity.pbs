#!/bin/bash
#PBS -N crmwinfid
#PBS -l nodes=1:ppn=8
#PBS -l walltime=72:00:00
#PBS -j oe
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export L_LIST="16,32"
export DOPING="0.0,0.125"
export U=4.0
export DMRG_BLAS=8
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
echo "host=$(hostname) start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_window_fidelity.jl 2>&1 | tee crm_window_fidelity_progress.log
echo "end=$(date)"
