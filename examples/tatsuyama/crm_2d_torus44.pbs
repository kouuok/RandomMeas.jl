#!/bin/bash
#PBS -N crm2dt44
#PBS -l nodes=1:ppn=16
#PBS -l walltime=72:00:00
#PBS -j oe
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
# 4x4 トーラス: 16サイト・32量子ビット・セクター次元 1.66e8(ベクトル 1.33 GB)
# 全ベクトル展開(68 GB)は使わず、セクター表現から窓RDMを直接作る。
# chopin は 196 GB / 40コアなので Krylov 次元は削らなくてよい。
export LX=4 W=4
export CHI_EXP="${CHI_EXP:-1024}"
export LANCZOS_M=40
export LANCZOS_RESTART=60
export NU=240
export N_REPEAT=200
export DMRG_BLAS=16
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
echo "host=$(hostname) UVAL=${UVAL} start=$(date)"
free -g | head -2
julia --project=Hubbard_MPS_Env_v2 crm_2d_torus_ed.jl 2>&1 | tee "crm_2d_t44_U${UVAL}_progress.log"
echo "end=$(date)"
