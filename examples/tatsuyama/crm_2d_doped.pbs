#!/bin/bash
#PBS -N crm_doped
#PBS -l nodes=1:ppn=16
#PBS -l walltime=12:00:00
#PBS -j oe

# 使い方: qsub -v UVAL=8.0 -N crm_dope_U8 -o crm_dope_U8.log crm_2d_doped.pbs
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export CHI_EXP="${CHI_EXP:-512}"
export DMRG_BLAS="${DMRG_BLAS:-16}"
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
echo "host=$(hostname) UVAL=${UVAL} CHI_EXP=${CHI_EXP} start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_2d_doped.jl
echo "end=$(date)"
