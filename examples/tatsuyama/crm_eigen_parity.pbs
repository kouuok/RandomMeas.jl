#!/bin/bash
#PBS -N crmparity
#PBS -l nodes=1:ppn=16
#PBS -l walltime=24:00:00
#PBS -j oe
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export W="${W:-1}" LX="${LX:-32}" PBC="${PBC:-0}" CRM_U="${CRM_U:-8.0}"
export DMRG_BLAS=16 JULIA_NUM_THREADS=1 JULIA_LOAD_PATH="@:@v#.#:@stdlib"
echo "host=$(hostname) W=${W} LX=${LX} PBC=${PBC} U=${CRM_U} start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_eigen_parity.jl 2>&1
echo "end=$(date)"
