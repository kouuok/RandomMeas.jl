#!/bin/bash
#PBS -N crm2dpbcfid
#PBS -l nodes=1:ppn=16
#PBS -l walltime=72:00:00
#PBS -j oe
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export W="${W:-4}" LX="${LX:-4}" PBC="${PBC:-1}" CRM_U="${CRM_U:-8.0}" CHIREF="${CHIREF:-1024}"
export DMRG_BLAS=16
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
GEO=$([ "$PBC" = "1" ] && echo torus || echo cylinder)
echo "host=$(hostname) ${W}x${LX} ${GEO} U=${CRM_U} chiref=${CHIREF} start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_2d_pbc_fid_vs_gain.jl 2>&1 \
  | tee "crm_2d_pbc_fid_W${W}L${LX}_${GEO}_progress.log"
echo "end=$(date)"
