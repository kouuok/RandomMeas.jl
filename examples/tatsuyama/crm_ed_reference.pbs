#!/bin/bash
#PBS -N crm_ed
#PBS -l nodes=1:ppn=8
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o crm_ed.log
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export L_LIST="${L_LIST:-4,6,8,10,12}"
export N_REPEAT="${N_REPEAT:-500}"
export CHI_EXP="${CHI_EXP:-256}"
export DMRG_BLAS=8
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
echo "host=$(hostname) L_LIST=${L_LIST} start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_ed_reference.jl 2>&1 | tee crm_ed_progress.log
echo "end=$(date)"
