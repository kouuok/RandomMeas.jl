#!/bin/bash
#PBS -N crm_gap
#PBS -l nodes=1:ppn=8
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o crm_gap.log
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export L_LIST="${L_LIST:-8,16,32,64,128}"
export CHI_EXP="${CHI_EXP:-256}"
export NSWEEPS="${NSWEEPS:-16}"
export DMRG_BLAS=8
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
echo "host=$(hostname) start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_gap_scaling.jl 2>&1 | tee crm_gap_progress.log
echo "end=$(date)"
