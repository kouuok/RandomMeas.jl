#!/bin/bash
#PBS -N crm2dsupp
#PBS -l nodes=1:ppn=16
#PBS -l walltime=72:00:00
#PBS -j oe
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export LX="${LX:-3}" W="${W:-4}"
export CHI_EXP="${CHI_EXP:-2048}"
export LANCZOS_M=40
export LANCZOS_RESTART=60
export NU=240
export N_REPEAT=200
export DMRG_BLAS=16
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
echo "host=$(hostname) W=${W} LX=${LX} UVAL=${UVAL} start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_2d_support.jl 2>&1 | tee "crm_2d_supp_W${W}L${LX}_U${UVAL}_progress.log"
echo "end=$(date)"
