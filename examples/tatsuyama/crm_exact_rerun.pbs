#!/bin/bash
#PBS -l nodes=1:ppn=16
#PBS -l walltime=12:00:00
#PBS -j oe

# 厳密な利得(G_exact 列)を加えた2次元・1次元掃引スクリプトの再実行用。
# 使い方: qsub -v SCRIPT=crm_2d_w6.jl,UVAL=4.0 -N ex_w6_U4 -o ex_w6_U4.log crm_exact_rerun.pbs
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export CHI_EXP="${CHI_EXP:-512}"
export DMRG_BLAS="${DMRG_BLAS:-16}"
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
export GKSwstype=100
echo "host=$(hostname) SCRIPT=${SCRIPT} UVAL=${UVAL} X0=${X0} CHI_EXP=${CHI_EXP} start=$(date)"
julia --project=Hubbard_MPS_Env_v2 "${SCRIPT}"
echo "end=$(date)"
