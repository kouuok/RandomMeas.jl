#!/bin/bash
#PBS -N crm_sens2
#PBS -l nodes=1:ppn=8
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o crm_sens2.log
cd "$HOME/RandomMeas.jl/examples/tatsuyama" || exit 1
export DMRG_BLAS=8
export JULIA_NUM_THREADS=1
export JULIA_LOAD_PATH="@:@v#.#:@stdlib"
echo "host=$(hostname) start=$(date)"
julia --project=Hubbard_MPS_Env_v2 crm_sensitivity2.jl 2>&1 | tee crm_sens2_progress.log
echo "end=$(date)"
